{"globalVariables":[],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1790519422086,"localVariables":[{"description":"","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":true,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"json","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},{"description":"","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":200.0,"m_intValue":200,"m_name":"http_code","m_stringValue":"","m_type":1,"supportsInput":false,"supportsOutput":true}],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":-8062181820683562099,"m_actionList":[{"blockNextAction":true,"responseVariableName":"json","runInBackgroundThread":false,"scriptText":"import android.content.ContentResolver;\nimport android.database.Cursor;\nimport android.provider.CalendarContract;\nimport android.provider.Settings;\nimport android.content.Intent;\nimport android.content.IntentFilter;\n\nimport org.json.JSONArray;\nimport org.json.JSONObject;\n\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\nlong nowMs \u003d System.currentTimeMillis();\nlong nowSec \u003d nowMs / 1000L;\n\nint battery \u003d 0;\n\ntry {\n    Intent batteryIntent \u003d appContext.registerReceiver(\n        null,\n        new IntentFilter(Intent.ACTION_BATTERY_CHANGED)\n    );\n\n    if (batteryIntent !\u003d null) {\n        int level \u003d batteryIntent.getIntExtra(\n            \"level\",\n            -1\n        );\n\n        int scale \u003d batteryIntent.getIntExtra(\n            \"scale\",\n            -1\n        );\n\n        if (level \u003e\u003d 0 \u0026\u0026 scale \u003e 0) {\n            battery \u003d Math.round(\n                level * 100.0f / scale\n            );\n        }\n    }\n} catch (Exception e) {\n    battery \u003d 0;\n}\n\njava.util.Calendar tomorrow \u003d java.util.Calendar.getInstance();\ntomorrow.setTimeInMillis(nowMs);\n\ntomorrow.set(\n    java.util.Calendar.HOUR_OF_DAY, 0\n);\ntomorrow.set(\n    java.util.Calendar.MINUTE, 0\n);\ntomorrow.set(\n    java.util.Calendar.SECOND, 0\n);\ntomorrow.set(\n    java.util.Calendar.MILLISECOND, 0\n);\n\ntomorrow.add(java.util.Calendar.DAY_OF_MONTH, 1);\n\njava.util.Calendar dayAfterTomorrow \u003d\n    (java.util.Calendar) tomorrow.clone();\n\ndayAfterTomorrow.add(\n    java.util.Calendar.DAY_OF_MONTH, 1\n);\n\nlong endWindowMs \u003d dayAfterTomorrow.getTimeInMillis();\n\nlong alarm \u003d 0;\n\ntry {\n    android.app.AlarmManager alarmManager \u003d\n        (android.app.AlarmManager) appContext.getSystemService(\n            android.content.Context.ALARM_SERVICE\n        );\n\n    if (alarmManager !\u003d null \u0026\u0026\n        android.os.Build.VERSION.SDK_INT \u003e\u003d 21) {\n\n        android.app.AlarmManager.AlarmClockInfo alarmInfo \u003d\n            alarmManager.getNextAlarmClock();\n\n        if (alarmInfo !\u003d null) {\n            alarm \u003d alarmInfo.getTriggerTime() / 1000L;\n        }\n    }\n\n} catch (Exception e) {\n    alarm \u003d 0;\n}\n\nList events \u003d new ArrayList();\n\nCursor cursor \u003d null;\n\ntry {\n    ContentResolver resolver \u003d appContext.getContentResolver();\n\n    android.net.Uri uri \u003d CalendarContract.Instances.CONTENT_URI\n        .buildUpon()\n        .appendPath(String.valueOf(nowMs))\n        .appendPath(String.valueOf(endWindowMs))\n        .build();\n\n    String[] projection \u003d new String[] {\n        CalendarContract.Instances.EVENT_ID,\n        CalendarContract.Instances.TITLE,\n        CalendarContract.Instances.BEGIN,\n        CalendarContract.Instances.END\n    };\n\n    cursor \u003d resolver.query(\n        uri,\n        projection,\n        CalendarContract.Instances.END + \" \u003e ? AND \" +\n        CalendarContract.Instances.BEGIN + \" \u003c ?\",\n        new String[] {\n            String.valueOf(nowMs),\n            String.valueOf(endWindowMs)\n        },\n        CalendarContract.Instances.BEGIN + \" ASC\"\n    );\n\n    if (cursor !\u003d null) {\n\n        int titleIndex \u003d\n            cursor.getColumnIndex(CalendarContract.Instances.TITLE);\n\n        int beginIndex \u003d\n            cursor.getColumnIndex(CalendarContract.Instances.BEGIN);\n\n        int endIndex \u003d\n            cursor.getColumnIndex(CalendarContract.Instances.END);\n\n        while (cursor.moveToNext()) {\n\n            String title \u003d \"\";\n\n            if (titleIndex \u003e\u003d 0 \u0026\u0026 !cursor.isNull(titleIndex)) {\n                title \u003d cursor.getString(titleIndex);\n            }\n\n            long start \u003d 0;\n            long end \u003d 0;\n\n            if (beginIndex \u003e\u003d 0 \u0026\u0026 !cursor.isNull(beginIndex)) {\n                start \u003d cursor.getLong(beginIndex) / 1000L;\n            }\n\n            if (endIndex \u003e\u003d 0 \u0026\u0026 !cursor.isNull(endIndex)) {\n                end \u003d cursor.getLong(endIndex) / 1000L;\n            }\n\n            Map event \u003d new HashMap();\n\n            event.put(\"name\", title);\n            event.put(\"start\", Long.valueOf(start));\n            event.put(\"end\", Long.valueOf(end));\n\n            events.add(event);\n        }\n    }\n\n} catch (SecurityException e) {\n    events.clear();\n} catch (Exception e) {\n    events.clear();\n} finally {\n    if (cursor !\u003d null) {\n        cursor.close();\n    }\n}\n\nJSONObject root \u003d new JSONObject();\nJSONArray calendar \u003d new JSONArray();\n\ntry {\n\n    root.put(\"time\", nowSec);\n    root.put(\"alarm\", alarm);\n    root.put(\"battery\", battery);\n\n    for (int i \u003d 0; i \u003c events.size(); i++) {\n\n        Map event \u003d (Map) events.get(i);\n\n        JSONObject item \u003d new JSONObject();\n\n        item.put(\"name\", event.get(\"name\"));\n        item.put(\"start\", event.get(\"start\"));\n        item.put(\"end\", event.get(\"end\"));\n\n        calendar.put(item);\n    }\n\n    root.put(\"calendar\", calendar);\n\n} catch (Exception e) {\n\n    try {\n        root \u003d new JSONObject();\n        root.put(\"time\", nowSec);\n        root.put(\"alarm\", alarm);\n        root.put(\"battery\", battery);\n        root.put(\"calendar\", new JSONArray());\n    } catch (Exception ignored) {\n    }\n}\n\nreturn root.toString();","disableLogging":false,"m_SIGUID":-5117015512161230052,"m_classType":"JavaAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"requestConfig":{"allFilesAccessPath":"","allowAnyCertificate":false,"basicAuthEnabled":false,"basicAuthPassword":"","basicAuthUsername":"","blockNextAction":true,"clientCertEnabled":false,"clientCertKeyStoreDisplayName":"","clientCertKeyStoreUri":"","clientCertPassword":"","contentBodyDynamicFileName":"","contentBodyFileDisplayName":"","contentBodyFileUri":"","contentBodyFolderDisplayName":"","contentBodyFolderUri":"","contentBodySource":0,"contentBodyText":"{lv\u003djson}","contentType":"application/json","followRedirects":true,"headerParams":[{"paramName":"Authorization","paramValue":"Bearer \u003ctoken\u003e"}],"localFileUri":"","maxTotalDurationSeconds":3600,"prettifyJson":false,"proxyEnabled":false,"proxyHost":"","proxyPort":8080,"proxyType":0,"queryParams":[],"requestTimeOutSeconds":30,"requestType":1,"returnCodeVariableName":"http_code","saveResponseAllFilesAccessPath":"","saveResponseFileName":"","saveResponseFolderPathDisplayName":"","saveResponseFolderPathUri":"","saveResponseType":0,"saveResponseUseAllFilesAc